#!/bin/sh
# PeakOS's Swift grammar, reproduced from the tree-sitter-swift 0.7.4 crate's own
# src/grammar.json + src/scanner.c (the crate, not the upstream repository's grammar).
#
#   scripts/peakui-grammar regenerate   write src/parser.c (and tree-sitter headers) here
#   scripts/peakui-grammar check        regenerate in a temp copy and verify the checked-in parser
#
# Tree-sitter CLI 0.25.10 generates the parser; its only difference from the shipped
# parser.c was the version in the first comment, which regenerate normalizes.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cli=${TREE_SITTER_CLI:-"npx --yes tree-sitter-cli@0.25.10"}

normalize() {
    python3 - "$1" <<'PY'
import sys
path = sys.argv[1]
lines = open(path, encoding="utf-8").read().splitlines(keepends=True)
if lines:
    lines[0] = "/* Automatically @generated by tree-sitter */\n"
open(path, "w", encoding="utf-8").writelines(lines)
PY
}

generate() {
    dir=$1
    cd "$dir"
    # shellcheck disable=SC2086
    $cli generate --abi 15 src/grammar.json >/dev/null
    normalize src/parser.c
}

test_grammar() {
    dir=$1
    cd "$dir"
    printf 'let b = Binding { 1 } set: { minutes in 2 }\n' > "$dir/multiple.swift"
    printf 'let s = #"value \\#(x)"#\n' > "$dir/raw.swift"
    # shellcheck disable=SC2086
    multiple=$($cli parse "$dir/multiple.swift" 2>/dev/null) || return 1
    # shellcheck disable=SC2086
    raw=$($cli parse "$dir/raw.swift" 2>/dev/null) || return 1
    echo "$multiple" | grep -q ERROR && { echo "multiple trailing closures do not parse" >&2; return 1; }
    [ "$(echo "$multiple" | grep -c 'lambda_literal')" -ge 2 ] || { echo "multiple trailing closures: fewer than two closures" >&2; return 1; }
    echo "$raw" | grep -q ERROR && { echo "raw-string interpolation does not parse" >&2; return 1; }
    echo "$raw" | grep -q 'raw_str_interpolation' || { echo "raw-string interpolation is not the raw_str_interpolation node" >&2; return 1; }
}

case ${1:-} in
    regenerate)
        generate "$root"
        test_grammar "$root"
        ;;
    check)
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        mkdir -p "$tmp/src"
        cp src/grammar.json "$tmp/src/grammar.json"
        cp src/scanner.c "$tmp/src/scanner.c"
        generate "$tmp"
        if ! diff -q src/parser.c "$tmp/src/parser.c" >/dev/null; then
            echo "peakui-grammar: src/parser.c is not what src/grammar.json generates" >&2
            exit 1
        fi
        test_grammar "$root"
        echo "peakui-grammar: parser.c is current; multiple trailing closures and raw interpolation parse"
        ;;
    *)
        echo "usage: scripts/peakui-grammar regenerate|check" >&2
        exit 2
        ;;
esac
